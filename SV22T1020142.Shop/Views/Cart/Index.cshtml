@model SV22T1020142.Shop.Models.CartViewModel

@{
    ViewData["Title"] = "Giỏ hàng";
}

<h2 class="fw-bold mb-4">Giỏ hàng của bạn</h2>

@if (Model.Items.Any())
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead class="table-light">
                <tr>
                    <th>Sản phẩm</th>
                    <th width="150">Đơn giá</th>
                    <th width="140">Số lượng</th>
                    <th width="150">Thành tiền</th>
                    <th width="100"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="@(string.IsNullOrEmpty(item.Product.Photo) ? "/images/no-image.png" : item.Product.Photo)"
                                     width="70" height="70"
                                     style="object-fit:contain"
                                     onerror="this.src='/images/no-image.png'" />
                                <div>
                                    <div class="fw-semibold">@item.Product.ProductName</div>
                                </div>
                            </div>
                        </td>
                        <td>@item.Product.Price.ToString("N0") đ</td>
                        <td>
                            <form asp-controller="Cart" asp-action="Update" method="post" class="d-flex gap-2">
                                <input type="hidden" name="productID" value="@item.Product.ProductID" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm" />
                                <button class="btn btn-sm btn-outline-primary">Cập nhật</button>
                            </form>
                        </td>
                        <td class="text-danger fw-bold">@item.TotalPrice.ToString("N0") đ</td>
                        <td>
                            <a asp-controller="Cart" asp-action="Remove" asp-route-id="@item.Product.ProductID"
                               class="btn btn-sm btn-outline-danger">
                                Xóa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="text-end mt-4">
        <h4>Tổng cộng: <span class="text-danger">@Model.TotalAmount.ToString("N0") đ</span></h4>

        <div class="mt-3 d-flex justify-content-end gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                Tiếp tục mua hàng
            </a>
            <a asp-controller="Cart" asp-action="Checkout" class="btn btn-primary">
                Đặt hàng
            </a>
        </div>
    </div>
}
else
{
    <div class="alert alert-warning">
        Giỏ hàng của bạn đang trống.
    </div>

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
        Quay về mua hàng
    </a>
}