@model SV22T1020142.Shop.Models.CheckoutViewModel

@{
    ViewData["Title"] = "Đặt mua hàng";
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                <h2 class="fw-bold mb-3">Thông tin nhận hàng</h2>
                <p class="text-muted">Đơn hàng sẽ được lưu vào lịch sử mua hàng của tài khoản hiện tại.</p>

                <form asp-action="Checkout" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="col-md-6">
                        <label asp-for="CustomerName" class="form-label"></label>
                        <input asp-for="CustomerName" class="form-control" />
                        <span asp-validation-for="CustomerName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" />
                        <span asp-validation-for="Phone" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DeliveryProvince" class="form-label"></label>
                        <input asp-for="DeliveryProvince" class="form-control" />
                        <span asp-validation-for="DeliveryProvince" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="DeliveryAddress" class="form-label"></label>
                        <input asp-for="DeliveryAddress" class="form-control" />
                        <span asp-validation-for="DeliveryAddress" class="text-danger"></span>
                    </div>

                    <div class="col-12 d-flex gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại giỏ hàng</a>
                        <button type="submit" class="btn btn-primary">Xác nhận đặt hàng</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                <h4 class="fw-bold mb-3">Đơn hàng của bạn</h4>

                @foreach (var item in Model.Items)
                {
                    <div class="d-flex justify-content-between align-items-start border-bottom py-3">
                        <div class="pe-3">
                            <div class="fw-semibold">@item.Product.ProductName</div>
                            <div class="text-muted small">@item.Quantity x @item.Product.Price.ToString("N0") đ</div>
                        </div>
                        <div class="fw-semibold text-danger">@item.TotalPrice.ToString("N0") đ</div>
                    </div>
                }

                <div class="d-flex justify-content-between pt-3 mt-2">
                    <div class="fw-semibold">Tổng thanh toán</div>
                    <div class="fw-bold text-danger fs-5">@Model.TotalAmount.ToString("N0") đ</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
