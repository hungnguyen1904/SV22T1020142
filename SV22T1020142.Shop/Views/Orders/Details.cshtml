@using SV22T1020142.Models.Sales
@model SV22T1020142.Shop.Models.OrderDetailsViewModel

@{
    ViewData["Title"] = $"Đơn hàng #{Model.Order.OrderID}";
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Đơn hàng #@Model.Order.OrderID</h2>
        <div class="text-muted">Ngày đặt: @Model.Order.OrderTime.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
    <a asp-action="MyOrders" class="btn btn-outline-secondary">Quay lại danh sách</a>
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Trạng thái xử lý</h5>
                <div class="mb-2"><strong>Hiện tại:</strong> @Model.Order.Status.GetDescription()</div>
                <div class="small text-muted">Nhận đơn: @(Model.Order.AcceptTime?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa xử lý")</div>
                <div class="small text-muted">Bàn giao shipper: @(Model.Order.ShippedTime?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa giao")</div>
                <div class="small text-muted">Hoàn tất/kết thúc: @(Model.Order.FinishedTime?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa hoàn tất")</div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Thông tin giao hàng</h5>
                <div><strong>Người đặt:</strong> @Model.Order.CustomerName</div>
                <div><strong>Email:</strong> @Model.Order.CustomerEmail</div>
                <div><strong>Điện thoại:</strong> @Model.Order.CustomerPhone</div>
                <div><strong>Địa chỉ:</strong> @Model.Order.DeliveryAddress</div>
                <div><strong>Tỉnh/thành:</strong> @Model.Order.DeliveryProvince</div>
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body">
                <h5 class="fw-bold mb-3">Chi tiết mặt hàng</h5>

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Details)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-3">
                                            <img src="@(string.IsNullOrWhiteSpace(item.Photo) ? "/images/no-image.png" : item.Photo)"
                                                 width="56"
                                                 height="56"
                                                 class="rounded-3 border"
                                                 style="object-fit:contain;"
                                                 onerror="this.src='/images/no-image.png'" />
                                            <div>
                                                <div class="fw-semibold">@item.ProductName</div>
                                                <div class="small text-muted">@item.Unit</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@item.SalePrice.ToString("N0") đ</td>
                                    <td>@item.Quantity</td>
                                    <td class="text-end fw-semibold text-danger">@item.TotalPrice.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="3" class="text-end">Tổng cộng</th>
                                <th class="text-end text-danger fs-5">@Model.TotalAmount.ToString("N0") đ</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
