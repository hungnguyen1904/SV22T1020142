@using SV22T1020142.Models.Sales
@model SV22T1020142.Shop.Models.MyOrdersViewModel

@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">Lịch sử mua hàng</h2>
        <p class="text-muted mb-0">Theo dõi trạng thái xử lý các đơn hàng cá nhân.</p>
    </div>
    <form asp-action="MyOrders" method="get" class="d-flex gap-2">
        <select name="status" class="form-select">
            @if (Model.Status == 0)
            {
                <option value="0" selected>Tất cả trạng thái</option>
            }
            else
            {
                <option value="0">Tất cả trạng thái</option>
            }
            @if (Model.Status == 1)
            {
                <option value="1" selected>Mới tạo</option>
            }
            else
            {
                <option value="1">Mới tạo</option>
            }
            @if (Model.Status == 2)
            {
                <option value="2" selected>Đã duyệt</option>
            }
            else
            {
                <option value="2">Đã duyệt</option>
            }
            @if (Model.Status == 3)
            {
                <option value="3" selected>Đang giao</option>
            }
            else
            {
                <option value="3">Đang giao</option>
            }
            @if (Model.Status == 4)
            {
                <option value="4" selected>Hoàn tất</option>
            }
            else
            {
                <option value="4">Hoàn tất</option>
            }
            @if (Model.Status == -1)
            {
                <option value="-1" selected>Đã hủy</option>
            }
            else
            {
                <option value="-1">Đã hủy</option>
            }
            @if (Model.Status == -2)
            {
                <option value="-2" selected>Bị từ chối</option>
            }
            else
            {
                <option value="-2">Bị từ chối</option>
            }
        </select>
        <button type="submit" class="btn btn-outline-primary">Lọc</button>
    </form>
</div>

@if (Model.Orders.DataItems.Any())
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th>Địa chỉ giao</th>
                        <th>Trạng thái</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Orders.DataItems)
                    {
                        <tr>
                            <td class="fw-semibold">#@item.OrderID</td>
                            <td>@item.OrderTime.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div>@item.DeliveryAddress</div>
                                <div class="text-muted small">@item.DeliveryProvince</div>
                            </td>
                            <td>@item.Status.GetDescription()</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.OrderID" class="btn btn-sm btn-outline-primary">
                                    Xem chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Orders.PageCount > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= Model.Orders.PageCount; i++)
                {
                    <li class="page-item @(i == Model.Orders.Page ? "active" : "")">
                        <a class="page-link" asp-action="MyOrders" asp-route-page="@i" asp-route-status="@Model.Status">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
else
{
    <div class="alert alert-info rounded-4">
        Chưa có đơn hàng nào phù hợp với bộ lọc hiện tại.
    </div>
}
