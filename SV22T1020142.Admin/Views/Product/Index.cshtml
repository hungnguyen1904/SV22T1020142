@model SV22T1020142.Models.Catalog.ProductSearchInput
@{
    ViewBag.Title = "Quản lý Mặt hàng";
}

@section PageToolBar {
    <a href="~/Product/Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>
        Bổ sung
    </a>
}

<div class="card mb-3">
    <div class="card-body">

        <form id="formSearch"
              method="get"
              action="~/Product/Search"
              data-target="searchResult"
              onsubmit="paginationSearch(event,this,1)">

            <div class="row g-2">

                <div class="col-md-3">
                    <label class="form-label">Loại hàng</label>
                    <select name="CategoryID" class="form-select">
                        <option value="">-- Tất cả --</option>

                        @foreach (var c in ((PagedResult<Category>)ViewBag.Categories).DataItems)
                        {
                            <option value="@c.CategoryID">@c.CategoryName</option>
                        }

                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Khoảng giá</label>

                    <div class="input-group">

                        <input type="text"
                               name="MinPrice"
                               class="form-control"
                               placeholder="Từ" />

                        <span class="input-group-text">-</span>

                        <input type="text"
                               name="MaxPrice"
                               class="form-control"
                               placeholder="Đến" />

                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Tên mặt hàng</label>

                    <div class="input-group">

                        <input type="text"
                               name="SearchValue"
                               class="form-control"
                               placeholder="Tên mặt hàng..." />

                        <button class="btn btn-info">
                            <i class="bi bi-search me-1"></i>
                        </button>

                    </div>
                </div>

                <input type="hidden" name="PageSize" value="@Model.PageSize" />

            </div>

        </form>

    </div>
</div>

<div id="searchResult"></div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            paginationSearch(null, document.getElementById("formSearch"), 1);
        });
    </script>
}