<div class="container-fluid mt-3">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title fw-bold">Thông tin hình ảnh</h3>
        </div>
        <div class="card-body">
            <form method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label">Chọn hình ảnh</label>
                    <input type="file" class="form-control" required>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox">
                    <label class="form-check-label">Ảnh chính</label>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary">Lưu</button>
                    <a href="~/Product/ListPhotos/@ViewBag.ProductId"
                       class="btn btn-secondary">Bỏ qua</a>
                </div>
            </form>
        </div>
    </div>
</div>
