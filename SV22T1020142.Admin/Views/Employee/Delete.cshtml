@model SV22T1020142.Models.HR.Employee

@{
    ViewBag.Title = "Xóa nhân viên";
}

@section PageToolBar {
    @if(ViewBag.CanDelete){
    <button type="submit" form="formDelete" class="btn btn-danger">
        <i class="bi bi-trash me-1"></i>
        Xóa
    </button>
    }

    <a href="~/Employee" class="btn btn-secondary ms-1">
        <i class="bi bi-arrow-left"></i>
        Quay lại
    </a>
}

<div class="row justify-content-center">
    <div class="col-12">
        <div class="card card-danger card-outline">

            <div class="card-header">
                <h5 class="card-title mb-0 text-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>
                    Xác nhận xóa nhân viên
                </h5>
            </div>

            <div class="card-body">

                <form id="formDelete" method="post" action="~/Employee/Delete/@Model.EmployeeID">

                    <input type="hidden" asp-for="EmployeeID" />
                    
                    @if(ViewBag.CanDelete){
                        <div class="alert alert-warning d-flex align-items-center">
                            <i class="bi bi-info-circle me-2"></i>
                            Bạn có chắc chắn muốn xóa nhân viên sau không?
                        </div>
                    }
                    else{
                        <div class="alert alert-info d-flex align-items-center">
                            <i class="bi bi-info-circle me-2"></i>
                            Nhân viên này đã có dữ liệu liên quan nên không thể xóa
                        </div>
                    }

                    <div class="row">
                        <div class="col-md-3 text-center">
                            <img src="~/images/employees/@(string.IsNullOrEmpty(Model.Photo) ? "nophoto.png" : Model.Photo)" class="img-thumbnail" style="max-height: 150px;"/>
                        </div>
                        <div class="col-md-9">
                            <dl class="row mb-0">
                                <dt class="col-sm-4">Họ và tên</dt>
                                <dd class="col-sm-8">@Model.FullName</dd>

                                <dt class="col-sm-4">Ngày sinh</dt>
                                <dd class="col-sm-8">@Model.BirthDate.ToString("dd/MM/yyyy")</dd>

                                <dt class="col-sm-4">Điện thoại</dt>
                                <dd class="col-sm-8">@Model.Phone</dd>

                                <dt class="col-sm-4">Email</dt>
                                <dd class="col-sm-8">@Model.Email</dd>

                                <dt class="col-sm-4">Địa chỉ</dt>
                                <dd class="col-sm-8">@Model.Address</dd>

                                <dt class="col-sm-4">Trạng thái làm việc</dt>
                                <dd class="col-sm-8">
                                    @if(Model.IsWorking)
                                    {
                                        <span class="badge bg-success">Đang làm việc</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Đã nghỉ việc</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>

                </form>

            </div>

        </div>
    </div>
</div>
